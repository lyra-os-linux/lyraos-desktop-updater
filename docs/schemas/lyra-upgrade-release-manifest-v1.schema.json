{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lyraos.com.br/schemas/lyra-upgrade-release-manifest-v1.schema.json",
  "title": "Lyra release upgrade manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence",
    "status",
    "valid_from",
    "valid_until",
    "source",
    "target",
    "minimum_updater_version",
    "minimum_free_space_bytes",
    "repositories",
    "allowed_removals",
    "allowed_vendor_transitions",
    "lockstep_packages"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["testing", "available", "paused", "withdrawn"] },
    "valid_from": { "type": "string", "format": "date-time" },
    "valid_until": { "type": "string", "format": "date-time" },
    "source": { "$ref": "#/$defs/releaseIdentity" },
    "target": { "$ref": "#/$defs/releaseIdentity" },
    "minimum_updater_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"
    },
    "minimum_free_space_bytes": { "type": "integer", "minimum": 1 },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/repository" }
    },
    "allowed_removals": {
      "type": "array",
      "items": { "$ref": "#/$defs/packageName" }
    },
    "allowed_vendor_transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 }
        }
      }
    },
    "lockstep_packages": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "uniqueItems": true,
        "items": { "$ref": "#/$defs/packageName" }
      }
    }
  },
  "$defs": {
    "releaseIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "edition", "architecture", "build_id"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "edition": { "const": "desktop" },
        "architecture": { "const": "x86_64" },
        "build_id": { "type": "string", "minLength": 1 }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "base_url", "signing_key_url", "signing_key_fingerprint", "priority"],
      "properties": {
        "alias": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" },
        "base_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "signing_key_url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "signing_key_fingerprint": { "type": "string", "pattern": "^[0-9A-F]{40}$" },
        "priority": { "type": "integer", "minimum": 1, "maximum": 200 }
      }
    },
    "packageName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+._-]+$"
    }
  }
}
