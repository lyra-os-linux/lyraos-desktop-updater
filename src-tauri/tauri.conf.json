{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lyra Upgrade",
  "version": "0.1.0",
  "identifier": "org.lyraos.LyraUpgrade",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "enableGTKAppId": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Lyra Upgrade",
        "width": 1040,
        "height": 760,
        "minWidth": 620,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
